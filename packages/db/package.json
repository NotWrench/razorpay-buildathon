{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./schema/auth": "./src/schema/auth.ts",
    "./schema/business": "./src/schema/business.ts",
    "./schema/ai": "./src/schema/ai.ts",
    "./agent": "./src/schema/agent.ts",
    "./project": "./src/schema/project.ts",
    "./schema/catalog": "./src/schema/catalog.ts",
    "./taxonomy": "./src/taxonomy.ts",
    "./schema/specs": "./src/schema/specs.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate && drizzle-kit generate --config drizzle.agent.config.ts",
    "db:migrate": "drizzle-kit migrate && drizzle-kit migrate --config drizzle.agent.config.ts",
    "db:push": "drizzle-kit push && drizzle-kit push --config drizzle.agent.config.ts",
    "db:studio": "drizzle-kit studio",
    "db:studio:agent": "drizzle-kit studio --config drizzle.agent.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "postgres": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@workspace/typescript-config": "workspace:*",
    "dotenv": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:"
  }
}
