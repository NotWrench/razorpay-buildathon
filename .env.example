PROJECT_DB_NAME=razorpay_project
PROJECT_DB_USER=postgres
PROJECT_DB_PASSWORD=postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5443/razorpay_project

# Agent database: conversations, reasoning logs, audit trail, agent memory.
# Kept separate from the business data so the agent's record can be queried,
# retained and cleared on its own. See packages/db/README.md.
AGENT_DB_NAME=razorpay_agent_memory
AGENT_DB_USER=postgres
AGENT_DB_PASSWORD=postgres
AGENT_DATABASE_URL=postgres://postgres:postgres@localhost:5445/razorpay_agent_memory


# Razorpay (https://dashboard.razorpay.com/app/website-app-settings/api-keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Set in Dashboard > Settings > Webhooks; must match the endpoint secret
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Public base URL used for payment-link callbacks
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Session signing key for better-auth. Required in production builds: without
# it the server refuses to fall back on the library's default secret.
#   openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-32-random-bytes
BETTER_AUTH_URL=http://localhost:3000

# AI layer — Google Gemini. Without a key, chat is disabled but the catalog,
# payments and lexical search all still work.
GEMINI_API_KEY=
AI_CHAT_MODEL=gemini-3.6-flash

# Which provider answers chat: google (default) | nvidia | ollama.
# The agent suite runs on nvidia — Gemini's free tier is 20 requests a day and
# one `bun run verify:agent` is roughly forty.
AI_PROVIDER=nvidia

# NVIDIA NIM, an OpenAI-compatible endpoint. Key from https://build.nvidia.com.
# NIM serves no Qwen model; gpt-oss-120b is the default because it is the one
# that reliably emits well-formed calls against the 25-tool storefront set.
NVIDIA_API_KEY=
NVIDIA_CHAT_MODEL=openai/gpt-oss-120b

# Local models, when AI_PROVIDER=ollama. Note that Ollama defaults every model
# to a 4096-token context and the agent prompt is roughly 8k before the
# conversation starts, so raise it (OLLAMA_CONTEXT_LENGTH on the server, or a
# Modelfile `PARAMETER num_ctx 16384`) or the model silently sees no tools.
OLLAMA_CHAT_MODEL=qwen2.5:3b-instruct
AI_FAST_MODEL=gemini-3.5-flash-lite
# Embeddings are forced to 1536 dimensions to match the products.embedding column.
AI_EMBEDDING_MODEL=gemini-embedding-001

# Agent bounds. The ceiling is 0 by design: every money action stops for a human.
AGENT_SPEND_CAP_PAISE=5000000
AGENT_AUTO_APPROVE_CEILING_PAISE=0
# Signs tool-approval requests so a client cannot forge one. Falls back to RAZORPAY_KEY_SECRET.
AGENT_APPROVAL_SECRET=

# Used by scripts/ai-buyer.ts — an API key issued from the merchant dashboard.
AI_BUYER_API_KEY=
AI_BUYER_STORE_SLUG=nova-electronics
