PROJECT_DB_NAME=razorpay_project
PROJECT_DB_USER=postgres
PROJECT_DB_PASSWORD=postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5443/razorpay_project

# Agent database: conversations, reasoning logs, audit trail, agent memory.
# Kept separate from the business data so the agent's record can be queried,
# retained and cleared on its own. See packages/db/README.md.
AGENT_DB_NAME=razorpay_agent_memory
AGENT_DB_USER=postgres
AGENT_DB_PASSWORD=postgres
AGENT_DATABASE_URL=postgres://postgres:postgres@localhost:5445/razorpay_agent_memory


# Razorpay (https://dashboard.razorpay.com/app/website-app-settings/api-keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Set in Dashboard > Settings > Webhooks; must match the endpoint secret
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Public base URL used for payment-link callbacks
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Session signing key for better-auth. Required in production builds: without
# it the server refuses to fall back on the library's default secret.
#   openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-32-random-bytes
BETTER_AUTH_URL=http://localhost:3000

# Google is the only sign-in method. Create an OAuth 2.0 Client ID (type: Web
# application) at https://console.cloud.google.com/apis/credentials and add
#   http://localhost:3000/api/auth/callback/google
# as an Authorised redirect URI — in production, the same path on your domain.
# Without these two the /login screen says so rather than offering a button
# that lands on a Google error page.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Who `bun run seed` makes the demo store's owner. Sign-in is Google-only, so
# set this to your own Google address: the first Google sign-in on it links to
# the seeded user, and the manager's Connect Razorpay button then acts on a
# store you actually own. Defaults to merchant@example.com, which nobody can
# sign in as.
SEED_OWNER_EMAIL=

# AI layer — Google Gemini. Without a key, chat is disabled but the catalog,
# payments and lexical search all still work.
GEMINI_API_KEY=
AI_CHAT_MODEL=gemini-3.6-flash

# Which provider answers chat: google (default) | nvidia | ollama.
# The agent suite runs on nvidia — Gemini's free tier is 20 requests a day and
# one `bun run verify:agent` is roughly forty.
AI_PROVIDER=nvidia

# NVIDIA NIM, an OpenAI-compatible endpoint. Key from https://build.nvidia.com.
# Do not put an `openai/gpt-oss-*` model here. That family speaks Harmony, a
# prompt format with its own header grammar, and NIM rejects the whole
# completion with a 400 whenever the model writes a header its parser will not
# take — about one turn in four, always mid conversation. Nothing on this side
# can fix it: the request is fine and the generation is not.
# A Nemotron emits ordinary JSON tool calls, has no second grammar to corrupt,
# and is roughly ten times faster here besides. `bun run models:probe`
# re-measures the shortlist; NIM serves no Qwen model and several it lists 404
# or ignore `tools` outright.
NVIDIA_API_KEY=
NVIDIA_CHAT_MODEL=nvidia/nemotron-3-super-120b-a12b

# Local models, when AI_PROVIDER=ollama. Note that Ollama defaults every model
# to a 4096-token context and the agent prompt is roughly 8k before the
# conversation starts, so raise it (OLLAMA_CONTEXT_LENGTH on the server, or a
# Modelfile `PARAMETER num_ctx 16384`) or the model silently sees no tools.
OLLAMA_CHAT_MODEL=qwen2.5:3b-instruct
AI_FAST_MODEL=gemini-3.5-flash-lite
# Embeddings are forced to 1536 dimensions to match the products.embedding column.
AI_EMBEDDING_MODEL=gemini-embedding-001

# Which provider produces embeddings: google (default) | ollama. Set apart from
# AI_PROVIDER because Gemini's free embedding quota is the tightest budget in
# this stack — a couple of dozen searches can exhaust it. Pointing embeddings at
# a local Ollama model removes the quota entirely while chat stays hosted:
#
#   ollama pull nomic-embed-text
#   AI_EMBEDDING_PROVIDER=ollama
#   bun run embed          # re-embeds: vectors from two models are incomparable
#
# NVIDIA NIM is not an option here — its embedding models return 2048 dimensions
# with no way to ask for fewer, and pgvector's HNSW index stops at 2000.
AI_EMBEDDING_PROVIDER=google
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# How long to stop calling the embedding provider after it answers with a 429.
# During the cooldown, search goes straight to lexical matching instead of
# spending a round trip — and another unit of an exhausted quota — to be refused.
AI_EMBEDDING_COOLDOWN_MS=300000

# How far the best semantic hit must lead the catalog's median similarity before
# the results count as a match at all. This is what stops a search for a laptop
# returning the eight cheapest components in a store that sells no laptops. It is
# a property of the embedding model, so measure it with `bun run calibrate:search`
# rather than guessing, and re-measure after changing models.
AI_SEARCH_MIN_LEAD=0.065

# How long one agent turn may run before it is stopped and the buyer is told.
# Must stay below the `maxDuration` on app/api/agent/*/route.ts, so the agent
# gives up first — a function killed by the platform ends the stream with no
# explanation, which the UI can only render as a spinner that never stops.
AGENT_TURN_BUDGET_MS=150000

# Agent bounds. The ceiling is 0 by design: every money action stops for a human.
AGENT_SPEND_CAP_PAISE=5000000
AGENT_AUTO_APPROVE_CEILING_PAISE=0
# Signs tool-approval requests so a client cannot forge one. Falls back to RAZORPAY_KEY_SECRET.
AGENT_APPROVAL_SECRET=

# Used by scripts/ai-buyer.ts — an API key issued from the merchant dashboard.
AI_BUYER_API_KEY=
AI_BUYER_STORE_SLUG=nova-electronics
