{
  "name": "razorpay-buildathon",
  "version": "0.0.1",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@ai-sdk/google": "^4.0.58",
      "@ai-sdk/react": "^4.0.88",
      "@better-auth/api-key": "^1.7.2",
      "@tailwindcss/postcss": "^4.3.3",
      "@types/node": "^26.4.0",
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.5",
      "ai": "^7.0.85",
      "better-auth": "^1.7.2",
      "dotenv": "^17.4.2",
      "drizzle-kit": "^0.31.10",
      "drizzle-orm": "^0.45.2",
      "lucide-react": "^1.38.0",
      "next": "16.3.3",
      "next-themes": "^0.4.6",
      "postgres": "^3.4.9",
      "razorpay": "^2.9.6",
      "react": "19.2.8",
      "react-dom": "19.2.8",
      "tailwindcss": "^4.3.3",
      "typescript": "^7.0.2",
      "zod": "^4.5.4"
    }
  },
  "scripts": {
    "ai-buyer": "bun run scripts/ai-buyer.ts",
    "build": "turbo build",
    "check": "ultracite check",
    "db:down": "docker compose down",
    "db:generate": "bun --filter @workspace/db db:generate",
    "db:migrate": "bun --filter @workspace/db db:migrate",
    "db:push": "bun --filter @workspace/db db:push",
    "db:studio": "bun --filter @workspace/db db:studio",
    "db:studio:agent": "bun --filter @workspace/db db:studio:agent",
    "db:up": "docker compose up -d",
    "dev": "turbo dev",
    "embed": "bun run scripts/embed.ts",
    "fix": "ultracite fix",
    "format": "ultracite fix",
    "lint": "ultracite check",
    "seed": "bun run scripts/seed.ts",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "verify": "bun run scripts/verify.ts",
    "verify:agent": "bun run scripts/verify-agent.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@workspace/typescript-config": "workspace:*",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "ultracite": "^7.10.7"
  },
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=20.9.0"
  }
}
